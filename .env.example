# =============================================================================
# Halamanku — Environment variables
# Copy this file to `.env` and fill in the values below.
# =============================================================================

# Database
DATABASE_URL="postgresql://halamanku:halamanku@localhost:5433/halamanku?schema=public"

# Public app URL (used for Xendit redirect URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# =============================================================================
# Xendit billing (https://dashboard.xendit.co)
# Required for the /checkout flow. Get sandbox keys from
#   Settings → Developers → API Keys (generate a Development secret key)
#   Settings → Developers → Callbacks (generate a callback verification token)
# The app works fully without these — billing is purely opt-in.
# =============================================================================
XENDIT_SECRET_KEY=""
XENDIT_CALLBACK_TOKEN=""

# =============================================================================
# EmailJS transactional email (https://emailjs.com)
# Free tier: 200 emails/month, no domain verification, no recipient restrictions.
# Setup:
#   1. Sign up at emailjs.com and connect your Gmail/Outlook as the email service
#   2. Create a template with variables: {{user_name}}, {{to_email}}, {{verification_url}},
#      {{expires_in}}, {{year}}, {{reply_to}}
#   3. Set the template's "To Email" field to {{to_email}} (not a hardcoded address)
#   4. Enable "API access from non-browser environments" at /admin/account/security
#   5. Get your Public Key, Private Key, Service ID, and Template ID from the dashboard
# The app works fully without these — emails are skipped with a console warning.
# =============================================================================
EMAILJS_PUBLIC_KEY=""
EMAILJS_SERVICE_ID=""
EMAILJS_TEMPLATE_ID=""
EMAILJS_PRIVATE_KEY=""

# Secret used to sign the checkout success-URL token (HMAC-SHA256).
# Generate with: openssl rand -base64 32
# Required in production; a dev placeholder is used if unset in dev.
BILLING_TOKEN_SECRET=""

# =============================================================================
# Vercel Blob (file uploads)
# Required for the image upload feature in the admin section editor.
# Get a token from https://vercel.com/docs/storage/vercel-blob/quickstart
# =============================================================================
BLOB_READ_WRITE_TOKEN=""